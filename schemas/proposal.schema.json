{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yamk12nfu/ai-repo-ops/schemas/proposal.schema.json",
  "title": "ai-repo-ops proposal frontmatter",
  "description": "対象repoの .ai/local/proposals/*.md のYAML frontmatterを検証するauthoritative schema。本文はMarkdown、frontmatterは採否の状態と根拠だけを保持する。decision.by / decision.reason のstatus連動の非空必須はallOfで表現する（source重複などの意味検証はCLI側のzodが担う）。",
  "type": "object",
  "required": ["schema_version", "id", "status", "proposed_at_commit", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": ["open", "accepted", "rejected", "done", "superseded"]
    },
    "proposed_at_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["accepted", "rejected", "done", "superseded"]
          }
        }
      },
      "then": {
        "required": ["decision"],
        "properties": {
          "decision": {
            "required": ["by"],
            "properties": {
              "by": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["rejected", "superseded"]
          }
        }
      },
      "then": {
        "required": ["decision"],
        "properties": {
          "decision": {
            "required": ["reason"],
            "properties": {
              "reason": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
